APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://alos:change-me@localhost:5432/alos

GENESIS_BASE_URL=http://localhost:8100
GENESIS_INTERNAL_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

OTEL_SERVICE_NAME=alos-backend

# Path ke checkout/release alos-contracts untuk validasi runtime ToolRequest.
ALOS_CONTRACTS_PATH=../alos-contracts
ENABLE_TEST_TOOLS=false

# Use inmemory for deterministic development/test; configure smtp for real delivery.
EMAIL_PROVIDER=inmemory
EMAIL_FROM=
EMAIL_FROM_NAME=ALOS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
APP_PUBLIC_URL=
